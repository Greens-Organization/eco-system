# Values for docker-compose.prod.yml. Copy to .env.prod (gitignored) and fill.
# Generate secrets with: openssl rand -base64 48

# Public URL of the dashboard, as the browser sees it. https in production:
# better-auth then marks cookies Secure with the __Secure- prefix.
PUBLIC_URL=http://localhost:3000
DASHBOARD_PORT=3000

# Shared by the API and the dashboard; 32+ characters each.
BETTER_AUTH_SECRET=
CLIENT_IP_SECRET=

POSTGRES_USER=eco
POSTGRES_PASSWORD=
POSTGRES_DB=eco
REDIS_PASSWORD=

SMTP_FROM=no-reply@example.com

# Optional: errors to Sentry, traces/metrics/logs to an OTLP collector.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
