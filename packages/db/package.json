{
  "name": "@pack/db",
  "version": "0.0.0",
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "db:generate": "bun x --bun drizzle-kit generate",
    "db:migrate": "bun x --bun drizzle-kit migrate",
    "db:studio": "bun x --bun drizzle-kit studio",
    "db:seed": "bun --bun seed.ts",
    "db:reset": "./scripts/reset-db.ts",
    "db:reset:force": "./scripts/reset-db.ts --force",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "drizzle-orm": "0.45.1",
    "drizzle-seed": "0.3.1",
    "postgres": "3.4.8",
    "server-only": "catalog:",
    "ws": "8.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pack/tools": "workspace:*",
    "@pack/tsconfig": "workspace:*",
    "drizzle-kit": "0.31.9"
  }
}
