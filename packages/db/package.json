{
  "name": "@pack/db",
  "version": "0.0.0",
  "exports": {
    ".": "./index.ts",
    "./schema": "./schema/index.ts",
    "./pack-env": "./pack-env.ts",
    "./seed/admin": "./src/seed/admin.seed.ts"
  },
  "scripts": {
    "test": "bun test",
    "db:generate": "bun x --bun drizzle-kit generate",
    "db:migrate": "bun x --bun drizzle-kit migrate",
    "db:migrate:deploy": "bun src/migrate.ts",
    "db:studio": "bun x --bun drizzle-kit studio",
    "db:seed": "bun --bun src/seed/index.ts",
    "db:reset": "bun run ./src/reset-db.ts",
    "clean": "git clean -xdf .cache .turbo dist node_modules"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "drizzle-orm": "0.45.3",
    "drizzle-seed": "0.3.1",
    "postgres": "3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pack/tools": "workspace:*",
    "@pack/tsconfig": "workspace:*",
    "drizzle-kit": "0.31.11"
  }
}
