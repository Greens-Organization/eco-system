{
  "extends": "@pack/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next",
      },
    ],
    "paths": {
      "@pack/*": ["../*"],
      "@pack/design-system/*": ["./*"],
    },
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"],
}
