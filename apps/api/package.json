{
  "name": "api",
  "private": true,
  "scripts": {
    "dev": "bun run --hot ./src/server.ts | pino-pretty",
    "build": "bun build src/server.ts --compile --outfile=api",
    "preview": "./api",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "bun test test/unit --preload @pack/testing/preload",
    "test:watch": "bun test test/unit --watch --preload @pack/testing/preload",
    "test:coverage": "bun test test/unit --coverage --preload @pack/testing/preload",
    "test:e2e": "bun run test/e2e/run.ts",
    "docker:infra:up": "docker compose -f docker-compose.local.yml up -d",
    "docker:infra:down": "docker compose -f docker-compose.local.yml down"
  },
  "dependencies": {
    "@hono/otel": "1.1.2",
    "@hono/zod-openapi": "1.4.0",
    "@pack/auth": "workspace:*",
    "@pack/db": "workspace:*",
    "@pack/observability": "workspace:*",
    "@pack/payments": "workspace:*",
    "@pack/testing": "workspace:*",
    "@scalar/hono-api-reference": "0.11.3",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pack/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "concurrently": "10.0.3",
    "drizzle-orm": "0.45.2",
    "pino-pretty": "catalog:",
    "postgres": "3.4.9"
  }
}
