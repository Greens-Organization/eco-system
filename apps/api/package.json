{
  "name": "api",
  "private": true,
  "scripts": {
    "dev": "bun run --hot ./src/server.ts",
    "build": "bun build src/server.ts --compile --outfile=api",
    "preview": "./api",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "docker:infra:up": "docker compose -f docker-compose.local.yml up -d",
    "docker:infra:down": "docker compose -f docker-compose.local.yml down"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.3.0",
    "@pack/auth": "workspace:*",
    "@pack/db": "workspace:*",
    "@pack/observability": "workspace:*",
    "@pack/payments": "workspace:*",
    "@pack/testing": "workspace:*",
    "@scalar/hono-api-reference": "0.10.14",
    "hono": "4.12.18",
    "vitest": "catalog:testing",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pack/tsconfig": "workspace:*",
    "concurrently": "9.2.1"
  }
}
