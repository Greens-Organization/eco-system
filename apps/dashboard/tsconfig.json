{
  "extends": "@pack/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@pack/*": ["../../packages/*"],
      "@api/*": ["../api/src/*"],
      "@/core/*": ["../api/src/core/*"],
      "@/infra/*": ["../api/src/infra/*"],
      "@/main/*": ["../api/src/main/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ]
}
