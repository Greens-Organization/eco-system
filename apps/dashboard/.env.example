NODE_ENV=development

# Observability (false for production)
LOG_PRETTY=true
SERVICE_NAME=dashboard
# Empty = off. Read from the process environment by
# src/instrumentation.server.ts before the app loads: under `vite dev`
# export them in the shell, the build reads them like any other env var.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# API (Hono backend)
API_URL=http://localhost:3002

# Must match the API's BETTER_AUTH_SECRET — used to verify the
# HMAC-signed session cookie cache locally (no DB hop on the fast path).
BETTER_AUTH_SECRET=

# Must match the API's CLIENT_IP_SECRET — signs the visitor's IP sent with
# every auth call, so the API's rate limits key on the real client.
# At least 32 characters: openssl rand -base64 48
CLIENT_IP_SECRET=
