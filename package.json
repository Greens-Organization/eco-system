{
  "name": "eco-system",
  "version": "2.0.0",
  "module": "index.ts",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "lint": "biome check ./",
    "format": "biome check --write ./",
    "clean": "git clean -xdf .cache .turbo node_modules",
    "clean:all": "bun ./scripts/cleanup.ts",
    "tree": "tree -I 'node_modules|.cache|.turbo|dist' -L 10"
  },
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@pack/tsconfig": "workspace:*",
    "@types/bun": "1.3.13",
    "turbo": "2.9.11",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "clsx": "2.1.1",
      "server-only": "0.0.1",
      "date-fns": "4.1.0",
      "ky": "1.14.3",
      "postcss": "8.5.14",
      "tailwindcss": "4.3.0",
      "@tailwindcss/typography": "0.5.19",
      "tw-animate-css": "1.4.0",
      "@tailwindcss/postcss": "4.3.0",
      "tailwind-merge": "3.5.0",
      "zod": "4.4.3",
      "es-toolkit": "1.46.1",
      "svelte": "5.55.5",
      "@sveltejs/kit": "2.59.1",
      "@sveltejs/adapter-node": "5.5.4",
      "@sveltejs/vite-plugin-svelte": "7.1.2",
      "vite": "8.0.11",
      "bits-ui": "2.18.1",
      "mode-watcher": "1.1.0",
      "lucide-svelte": "1.0.1",
      "svelte-sonner": "1.1.0",
      "@tanstack/svelte-form": "1.28.5",
      "class-variance-authority": "0.7.1"
    },
    "catalogs": {
      "testing": {
        "vitest": "4.1.5"
      },
      "dev": {
        "@types/node": "25.6.2",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3"
      }
    }
  }
}
