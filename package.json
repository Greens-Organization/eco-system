{
  "name": "eco-system",
  "version": "2.0.0",
  "module": "index.ts",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "lint": "biome check ./",
    "format": "biome check --write ./",
    "clean": "git clean -xdf node_modules",
    "clean:all": "bun ./scripts/cleanup.ts",
    "tree": "tree -I 'node_modules|.cache|.turbo|dist' -L 10"
  },
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@pack/typescript-config": "workspace:*",
    "@types/bun": "1.3.6",
    "@types/node": "25.0.10",
    "turbo": "2.7.6",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@tanstack/react-form": "1.27.7",
      "lucide-react": "0.563.0",
      "clsx": "2.1.1",
      "server-only": "0.0.1",
      "date-fns": "4.1.0",
      "next": "16.1.4",
      "next-themes": "0.4.6",
      "ky": "1.14.3",
      "postcss": "8.5.6",
      "tailwindcss": "4.1.18",
      "tailwind-merge": "3.4.0",
      "zod": "4.3.6",
      "es-toolkit": "1.44.0",
      "@t3-oss/env-core": "0.13.10",
      "@t3-oss/env-nextjs": "0.13.10",
      "@sentry/nextjs": "10.36.0"
    },
    "catalogs": {
      "testing": {
        "@vitejs/plugin-react": "5.1.2",
        "vitest": "4.0.18"
      },
      "dev": {
        "@types/node": "25.0.10",
        "@types/react": "19.2.9",
        "@types/react-dom": "19.2.3"
      }
    }
  }
}
