{
  "name": "eco-system",
  "version": "2.0.0",
  "module": "index.ts",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "test:e2e": "bun run --filter @app/dashboard-api test:e2e",
    "test:browser": "bun run --filter @app/dashboard-svelte test:browser",
    "check:svelte": "turbo check:svelte",
    "verify": "biome check ./ && bun check && turbo check:svelte build",
    "setup": "bun install && bun run docker:infra:up && bun run db:migrate && bun run db:seed",
    "db:generate": "bun run --filter @pack/db db:generate",
    "db:migrate": "bun run --filter @pack/db db:migrate",
    "db:seed": "bun run --filter @pack/db db:seed",
    "db:reset": "bun run --filter @pack/db db:reset",
    "db:studio": "bun run --filter @pack/db db:studio",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "lint": "biome check ./",
    "format": "biome check --write ./",
    "clean": "git clean -xdf .cache .turbo node_modules",
    "clean:all": "bun ./scripts/cleanup.ts",
    "tree": "tree -I 'node_modules|.cache|.turbo|dist' -L 10",
    "docker:infra:up": "docker compose -f infra/docker/docker-compose.infra.yml up -d --wait",
    "docker:infra:down": "docker compose -f infra/docker/docker-compose.infra.yml down",
    "docker:infra:ps": "docker compose -f infra/docker/docker-compose.infra.yml ps",
    "docker:infra:restart": "docker compose -f infra/docker/docker-compose.infra.yml restart",
    "docker:obs:up": "docker compose -f infra/docker/docker-compose.observability.yml up -d",
    "docker:obs:down": "docker compose -f infra/docker/docker-compose.observability.yml down"
  },
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@pack/tsconfig": "workspace:*",
    "@types/bun": "catalog:dev",
    "turbo": "2.11.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "bun@1.4.3",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "clsx": "2.1.1",
      "date-fns": "4.1.0",
      "ky": "1.14.3",
      "postcss": "8.5.28",
      "tailwindcss": "4.3.3",
      "@tailwindcss/typography": "0.5.20",
      "tw-animate-css": "1.4.0",
      "@tailwindcss/postcss": "4.3.3",
      "tailwind-merge": "3.7.0",
      "zod": "4.6.5",
      "hono": "4.13.11",
      "es-toolkit": "1.52.0",
      "svelte": "5.57.1",
      "@sveltejs/kit": "2.70.3",
      "@sveltejs/adapter-node": "5.5.7",
      "@sveltejs/vite-plugin-svelte": "7.3.1",
      "vite": "8.3.1",
      "bits-ui": "2.19.3",
      "mode-watcher": "1.1.0",
      "@lucide/svelte": "1.49.0",
      "pino": "10.3.1",
      "pino-pretty": "13.1.3",
      "svelte-sonner": "1.2.1",
      "class-variance-authority": "0.7.1",
      "uqr": "0.1.3",
      "@hono/otel": "1.2.0",
      "@hono/zod-openapi": "1.6.3",
      "@scalar/hono-api-reference": "0.12.6",
      "drizzle-orm": "0.45.3",
      "postgres": "3.4.9",
      "@tailwindcss/vite": "4.3.3",
      "better-auth": "1.7.6",
      "@opentelemetry/api": "1.9.1",
      "drizzle-seed": "0.3.1",
      "@internationalized/date": "3.12.4",
      "tailwind-variants": "3.3.1",
      "nodemailer": "10.0.12",
      "@formatjs/intl-localematcher": "0.9.0",
      "negotiator": "1.1.0",
      "@opentelemetry/api-logs": "0.222.0",
      "@opentelemetry/exporter-logs-otlp-http": "0.222.0",
      "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
      "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
      "@opentelemetry/host-metrics": "0.39.0",
      "@opentelemetry/resources": "2.11.0",
      "@opentelemetry/sdk-logs": "0.222.0",
      "@opentelemetry/sdk-metrics": "2.11.0",
      "@opentelemetry/context-async-hooks": "2.11.0",
      "@opentelemetry/core": "2.11.0",
      "@opentelemetry/sdk-trace-base": "2.11.0",
      "@sentry/bun": "11.1.0",
      "@sentry/core": "11.1.0",
      "@sentry/node": "11.1.0",
      "schema-dts": "2.0.0"
    },
    "catalogs": {
      "dev": {
        "@types/bun": "1.4.3",
        "@playwright/test": "1.63.0",
        "svelte-check": "4.7.6",
        "drizzle-kit": "0.31.11",
        "@types/negotiator": "0.6.5"
      }
    }
  }
}
