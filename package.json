{
  "name": "eco-system",
  "version": "2.0.0",
  "module": "index.ts",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "lint": "biome check ./",
    "format": "biome check --write ./",
    "clean": "git clean -xdf .cache .turbo node_modules",
    "clean:all": "bun ./scripts/cleanup.ts",
    "tree": "tree -I 'node_modules|.cache|.turbo|dist' -L 10",
    "docker:infra:up": "docker compose -f infra/docker/docker-compose.infra.yml up -d",
    "docker:infra:down": "docker compose -f infra/docker/docker-compose.infra.yml down",
    "docker:infra:ps": "docker compose -f infra/docker/docker-compose.infra.yml ps",
    "docker:infra:restart": "docker compose -f infra/docker/docker-compose.infra.yml restart",
    "docker:obs:up": "docker compose -f infra/docker/docker-compose.observability.yml up -d",
    "docker:obs:down": "docker compose -f infra/docker/docker-compose.observability.yml down"
  },
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@pack/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "turbo": "2.9.18",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "clsx": "2.1.1",
      "date-fns": "4.1.0",
      "ky": "1.14.3",
      "postcss": "8.5.15",
      "tailwindcss": "4.3.1",
      "@tailwindcss/typography": "0.5.20",
      "tw-animate-css": "1.4.0",
      "@tailwindcss/postcss": "4.3.1",
      "tailwind-merge": "3.6.0",
      "zod": "4.4.3",
      "hono": "4.12.25",
      "es-toolkit": "1.47.1",
      "svelte": "5.56.3",
      "@sveltejs/kit": "2.65.1",
      "@sveltejs/adapter-node": "5.5.4",
      "@sveltejs/vite-plugin-svelte": "7.1.2",
      "vite": "8.0.16",
      "bits-ui": "2.18.1",
      "mode-watcher": "1.1.0",
      "@lucide/svelte": "1.18.0",
      "pino": "10.3.1",
      "pino-pretty": "13.1.3",
      "svelte-sonner": "1.1.0",
      "class-variance-authority": "0.7.1"
    },
    "catalogs": {
      "dev": {
        "@types/node": "25.9.3",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3"
      }
    }
  }
}
