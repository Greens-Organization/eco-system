{
  "name": "eco-system",
  "version": "2.0.0",
  "module": "index.ts",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "lint": "biome check ./",
    "format": "biome check --write ./",
